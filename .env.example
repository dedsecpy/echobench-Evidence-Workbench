# Export these in your shell, or use node --env-file=.env src/cli.js ...
# Model calls are optional. The offline demo needs no key.
ECHOBENCH_API_BASE=https://api.openai.com/v1
ECHOBENCH_MODEL=replace-with-an-available-model-id
ECHOBENCH_API_KEY=
# Local OpenAI-compatible servers may omit the key.
# ECHOBENCH_API_BASE=http://127.0.0.1:1234/v1
